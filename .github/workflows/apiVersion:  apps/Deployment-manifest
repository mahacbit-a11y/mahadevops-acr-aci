apiVersion:  apps/v1
kind: Deployment
metadata:
  name: web-app-deployment
  labels:
    app: web-app
spec:
  replicas:  3
  selector:
    matchLabels:
 template:
   metadata:
     labels:
      app:  web-app
   spec: 
     containers:
     - name: nginx-web-server
       image: nginx:1.25.3
       ports:
       - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: web-app-service
spec:
  type: LoadBalancer
  ports:
  - port: 80
  targetport:  80
  selector:
    app: web-app
